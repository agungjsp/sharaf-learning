{
  "name": "sharaf-learning",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts",
    "check": "node scripts/sync-source.mjs --check && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "coverage": "node scripts/coverage.ts",
    "source:sync": "node scripts/sync-source.mjs"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.47.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
